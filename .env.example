# ---------------------------------------------------------------------------
# GameFlex production environment template
# ---------------------------------------------------------------------------
# These variables are safe for source control. Real secrets must stay in a local
# untracked .env file or the deployment environment, never in this template.

# ---------------------------------------------------------------------------
# Site / branding (client-visible)
# ---------------------------------------------------------------------------
VITE_APP_NAME="GameFlex"
VITE_APP_DESCRIPTION="The world's premier gaming ecosystem."
VITE_SITE_URL="https://gameflex.co.ke"
VITE_CURRENCY="KES"
VITE_SUPPORT_EMAIL="support@gameflex.co.ke"
VITE_DEFAULT_LOBBY_SIZE="100"

# ---------------------------------------------------------------------------
# Backend provider selection (see docs/backend-providers.md)
# Each capability can point at a different provider.
# ---------------------------------------------------------------------------
# supabase | rest
VITE_BACKEND_PROVIDER="supabase"
# supabase | custom
VITE_AUTH_PROVIDER="supabase"
# supabase | s3 | r2 | vps (invalid values fail fast; no fallback)
VITE_STORAGE_PROVIDER="r2"
# supabase | none
VITE_REALTIME_PROVIDER="supabase"

# PostgREST-compatible data API (VITE_BACKEND_PROVIDER=rest)
VITE_BACKEND_REST_URL=""
VITE_BACKEND_REST_KEY=""

# Auth gateway (VITE_AUTH_PROVIDER=custom)
VITE_AUTH_API_URL=""

# Object storage gateway (required for VITE_STORAGE_PROVIDER=s3|r2|vps)
VITE_STORAGE_API_URL=""
VITE_STORAGE_PUBLIC_URL=""

# Server-only storage gateway configuration (never expose to the browser)
STORAGE_PROVIDER="r2"
STORAGE_API_URL=""
STORAGE_PUBLIC_URL=""
STORAGE_ROOT="/var/lib/gameflex-storage"
STORAGE_MAX_UPLOAD_BYTES="10485760"
STORAGE_JWT_AUDIENCE="gameflex-storage"
STORAGE_ALLOWED_ORIGINS="https://gameflex.co.ke,https://www.gameflex.co.ke"

# ---------------------------------------------------------------------------
# Supabase public configuration (client-visible)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------------
# Social sign-in (comma separated: google,apple,github,discord,azure)
# Providers must also be enabled in your auth backend.
# ---------------------------------------------------------------------------
VITE_OAUTH_PROVIDERS="google"

# ---------------------------------------------------------------------------
# Observability / analytics (optional)
# ---------------------------------------------------------------------------
VITE_ERROR_REPORTING_URL=""
VITE_ANALYTICS_ENABLED="true"

# ---------------------------------------------------------------------------
# Server-only variables (never exposed to the browser)
# These are required by server-side Supabase access and must live in the runtime
# environment, not in client-side VITE_* variables.
# ---------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWKS_URL=""

# Keep any bootstrap admin email server-side only if your hosting environment needs it.
DEFAULT_ADMIN_EMAIL=""
